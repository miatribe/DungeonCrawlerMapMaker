    "events": {
      "toggleHatch": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "edge",
              "id": "hatch"
            },
            "equals": "closed"
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "hatch"
            },
            "state": "open"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "hatch_lever"
            },
            "state": "on"
          },
          {
            "type": "showMessage",
            "text": "A trapdoor drops open in the north-east corner."
          }
        ],
        "else": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "hatch"
            },
            "state": "closed"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "hatch_lever"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "The trapdoor swings shut."
          }
        ]
      },
      "lowerRoom": {
        "once": true,
        "actions": [
          {
            "type": "showMessage",
            "text": "You've dropped into the room below. The ladder in the south-west corner leads back up."
          }
        ]
      }
    },
