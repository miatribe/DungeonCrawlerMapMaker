              "id": "portcullis"
            },
            "state": "open"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "hall_lever"
            },
            "state": "on"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "chains_heavy"
            }
          },
          {
            "type": "showMessage",
            "text": "Chains rattle. The portcullis to the south rises."
          }
        ],
        "else": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "portcullis"
            },
            "state": "closed"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "hall_lever"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "The portcullis slams down."
          }
        ]
      },
      "openArmoryChest": {
        "once": true,
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "armory_chest"
            },
            "state": "open"
          },
          {
            "type": "setFlag",
            "name": "item",
            "value": "key"
          },
          {
            "type": "setSurface",
            "cell": {
              "x": 6,
              "y": 7,
              "z": 0
            },
            "side": "east",
            "material": "mural"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "chest_open",
              "volume": 0.8
            }
          },
          {
            "type": "showMessage",
            "text": "Inside lies an iron key. As you lift it, a faded mural appears on the wall."
          }
        ]
      },
      "dartPlate": {
        "once": true,
        "actions": [
          {
            "type": "showMessage",
            "text": "Click."
          },
          {
            "type": "runEvent",
            "event": "dart",
            "delayMs": 1200
          }
        ]
      },
      "dart": {
        "actions": [
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "dart"
            }
          },
          {
            "type": "showMessage",
            "text": "A dart whistles past your ear!"
          }
        ]
      },
      "spikes": {
        "actions": [
          {
            "type": "addFlag",
            "name": "falls",
            "amount": 1
          },
          {
            "type": "showMessage",
            "text": "You land among rusted spikes. Somewhere a mechanism groans..."
          },
          {
            "type": "runEvent",
            "event": "rescue",
            "delayMs": 1500
          }
        ]
      },
      "rescue": {
        "actions": [
          {
            "type": "teleport",
            "to": {
              "x": 5,
              "y": 2,
              "z": 0
            },
            "facing": "north"
          },
          {
            "type": "showMessage",
            "text": "...and the floor lifts you back up into the hall."
          }
        ]
      },
      "useVaultDoor": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "equals": "locked"
          }
        ],
        "actions": [
          {
            "type": "runEvent",
            "event": "unlockVault"
          }
        ],
        "else": [
          {
            "type": "toggleConnectionState",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "states": [
              "closed",
              "open"
            ]
          }
        ]
      },
      "unlockVault": {
        "conditions": [
          {
            "type": "flag",
            "name": "item",
            "op": "==",
            "value": "key"
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "state": "closed"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "unlock"
            }
          },
          {
            "type": "showMessage",
            "text": "The iron key turns. The vault door is unlocked."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "Locked. There must be a key somewhere."
          }
        ]
      },
      "bumpVault": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "equals": "locked"
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "The vault door is locked."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "The vault door is shut. Use it to open it."
          }
        ]
      },
      "window": {
        "conditions": [
          {
            "type": "playerFacing",
            "facing": "north"
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "Through a narrow window you see the sea, grey under the moon."
          }
        ]
      },
      "towerButton": {
        "once": true,
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "tower_button"
            },
            "state": "down"
          },
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "library_wall"
            },
            "state": "open"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "stone_grind"
            }
          },
          {
            "type": "showMessage",
            "text": "A bookcase in the south wall swings aside."
          }
        ]
      },
      "takeTome": {
        "once": true,
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "tome_chest"
            },
            "state": "open"
          },
          {
            "type": "setFlag",
            "name": "tome",
            "value": true
          },
          {
            "type": "showMessage",
            "text": "You take the Tome of Echoes. The floor near the east shelves looks hollow."
          }
        ]
      },
      "oubliette": {
        "actions": [
          {
            "type": "addFlag",
            "name": "falls",
            "amount": 1
          },
          {
            "type": "showMessage",
            "text": "You tumble into a lightless oubliette."
          },
          {
            "type": "runEvent",
            "event": "outOfOubliette",
            "delayMs": 1500
          }
        ]
      },
      "outOfOubliette": {
        "actions": [
          {
            "type": "teleport",
            "to": {
              "x": 1,
              "y": 1,
              "z": 0
            },
            "facing": "east"
          },
          {
            "type": "showMessage",
            "text": "A cold wind carries you... back to the entrance."
          }
        ]
      },
      "awakenAltar": {
        "conditions": [
          {
            "type": "flag",
            "name": "tome",
            "op": "==",
            "value": true
          },
          {
            "type": "any",
            "conditions": [
              {
                "type": "flag",
                "name": "item",
                "op": "==",
                "value": "key"
              },
              {
                "type": "flag",
                "name": "visits",
                "op": ">=",
                "value": 3
              }
            ]
          },
          {
            "type": "not",
            "conditions": [
              {
                "type": "state",
                "target": {
                  "kind": "prop",
                  "id": "altar"
                },
                "equals": "awake"
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "altar"
            },
            "state": "awake"
          },
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "trapdoor"
            },
            "state": "open"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "hall_torch"
            },
            "state": "out"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "choir",
              "volume": 0.7
            }
          },
          {
            "type": "custom",
            "custom": "spawnMonster",
            "params": {
              "monster": "wraith",
              "at": {
                "x": 3,
                "y": 0,
                "z": 0
              },
              "near": "altar"
            }
          },
          {
            "type": "showMessage",
            "text": "The altar wakes with a sound like distant bells. A trapdoor opens in the hall floor, and something stirs in the shadows."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "The altar is cold. It wants the Tome of Echoes, and the key."
          }
        ]
      },
      "takeCrown": {
        "once": true,
        "conditions": [
          {
            "type": "custom",
            "custom": "hasItem",
            "params": {
              "item": "torch"
            }
          },
          {
            "type": "eventFired",
            "event": "awakenAltar"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "crown_chest"
            },
            "state": "open"
          },
          {
            "type": "setFlag",
            "name": "crown",
            "value": true
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "fanfare"
            }
          },
          {
            "type": "showMessage",
            "text": "The Crown of Echoes! Climb the ladder to leave the keep."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "It's too dark to find the latch."
          }
        ]
      },
      "leave": {
        "conditions": [
          {
            "type": "flag",
            "name": "crown",
            "op": "==",
            "value": true
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "You climb into the hall, crown in hand. The echoes fall silent. You win!"
          }
        ]
      }
    },
    "flags": {
      "item": {
        "type": "string",
        "initial": ""
      },
      "tome": {
        "type": "bool",
        "initial": false
      },
      "crown": {
        "type": "bool",
        "initial": false
      },
      "visits": {
        "type": "int",
        "initial": 0
      },
      "falls": {
        "type": "int",
        "initial": 0
      }
    },
    "tags": [
      "example",
      "showcase"
    ],
    "data": {
      "author": "DCMM examples",
      "difficulty": "easy"
    }
  }
}
