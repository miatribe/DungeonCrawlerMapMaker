    "customTypes": {},
    "events": {
      "pullLever": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "edge",
              "id": "lever_door"
            },
            "equals": "locked"
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "lever_door"
            },
            "state": "open"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever"
            },
            "state": "on"
          },
          {
            "type": "showMessage",
            "text": "Clunk. The bolt slides back and the east door swings open."
          }
        ],
        "else": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "lever_door"
            },
            "state": "locked"
          },
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "The door swings shut and the bolt slides home."
          }
        ]
      },
      "bumpLeverDoor": {
        "actions": [
          {
            "type": "showMessage",
            "text": "Locked tight, and there's no keyhole. Try the lever on the north wall."
          }
        ]
      },
      "pull_lever_a": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_a"
            },
            "equals": "off"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_a"
            },
            "state": "on"
          },
          {
            "type": "showMessage",
            "text": "Lever 1 clicks up."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ],
        "else": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_a"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "Lever 1 clicks down."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ]
      },
      "pull_lever_b": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_b"
            },
            "equals": "off"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_b"
            },
            "state": "on"
          },
          {
            "type": "showMessage",
            "text": "Lever 2 clicks up."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ],
        "else": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_b"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "Lever 2 clicks down."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ]
      },
      "pull_lever_c": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_c"
            },
            "equals": "off"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_c"
            },
            "state": "on"
          },
          {
            "type": "showMessage",
            "text": "Lever 3 clicks up."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ],
        "else": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "lever_c"
            },
            "state": "off"
          },
          {
            "type": "showMessage",
            "text": "Lever 3 clicks down."
          },
          {
            "type": "runEvent",
            "event": "checkLevers"
          }
        ]
      },
      "checkLevers": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_a"
            },
            "equals": "on"
          },
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_b"
            },
            "equals": "on"
          },
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "lever_c"
            },
            "equals": "on"
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "state": "open"
          },
          {
            "type": "showMessage",
            "text": "All three levers are up. The vault door grinds open!"
          }
        ],
        "else": [
          {
            "type": "runEvent",
            "event": "relockVault"
          }
        ],
        "notes": "Runs after any of the three levers moves. All up opens the vault; anything else locks it again."
      },
      "relockVault": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "equals": "open"
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "vault_door"
            },
            "state": "locked"
          },
          {
            "type": "showMessage",
            "text": "The vault door slams shut again."
          }
        ]
      },
      "bumpVault": {
        "actions": [
          {
            "type": "showMessage",
            "text": "The vault door won't move. Three levers in this room must all be up."
          }
        ]
      },
      "openChest": {
        "once": true,
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "chest"
            },
            "state": "open"
          },
          {
            "type": "setFlag",
            "name": "treasure",
            "value": true
          },
          {
            "type": "showMessage",
            "text": "Gold! You've opened every door. You win."
          }
        ]
      }
    },
    "flags": {
      "treasure": {
        "type": "bool",
        "initial": false
      }
    },
    "tags": [
      "example"
    ]
  }
