              "kind": "prop",
              "id": "dart_plate"
            },
            "state": "up"
          },
          {
            "type": "showMessage",
            "text": "A dart whistles through the spot where you just stood."
          }
        ],
        "notes": "Fires 1.2 s after the plate. It only hits if the player is still standing on it."
