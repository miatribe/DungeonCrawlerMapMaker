    "customTypes": {
      "playSound": {
        "category": "action",
        "name": "Play sound",
        "description": "Play a sound effect",
        "params": [
          {
            "name": "sound",
            "type": "string",
            "required": true
          },
          {
            "name": "volume",
            "type": "float",
            "default": 1
          }
        ]
      },
      "spawnMonster": {
        "category": "action",
        "name": "Spawn monster",
        "params": [
          {
            "name": "monster",
            "type": "enum",
            "options": [
              "skeleton",
              "ghoul"
            ],
            "required": true
          },
          {
            "name": "at",
            "type": "gridPos",
            "required": true
          }
        ]
      },
      "hasLight": {
        "category": "condition",
        "name": "Player carries a light",
        "params": []
      }
    },
    "events": {
      "welcome": {
        "actions": [
          {
            "type": "showMessage",
            "text": "The chapel is cold. Three braziers stand dark along the walls."
          }
        ]
      },
      "checkFlames": {
        "conditions": [
          {
            "type": "flag",
            "name": "flames",
            "op": ">=",
            "value": 3
          }
        ],
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "secret"
            },
            "state": "open"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "stone_grind"
            }
          },
          {
            "type": "showMessage",
            "text": "Stone grinds against stone. Part of the south wall slides away."
          }
        ]
      },
      "light_1": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "brazier_1"
            },
            "equals": "unlit"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "brazier_1"
            },
            "state": "lit"
          },
          {
            "type": "addFlag",
            "name": "flames",
            "amount": 1
          },
          {
            "type": "showMessage",
            "text": "The brazier flares to life."
          },
          {
            "type": "runEvent",
            "event": "checkFlames"
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "It's already burning."
          }
        ]
      },
      "light_2": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "brazier_2"
            },
            "equals": "unlit"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "brazier_2"
            },
            "state": "lit"
          },
          {
            "type": "addFlag",
            "name": "flames",
            "amount": 1
          },
          {
            "type": "showMessage",
            "text": "The brazier flares to life."
          },
          {
            "type": "runEvent",
            "event": "checkFlames"
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "It's already burning."
          }
        ]
      },
      "light_3": {
        "conditions": [
          {
            "type": "state",
            "target": {
              "kind": "prop",
              "id": "brazier_3"
            },
            "equals": "unlit"
          }
        ],
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "brazier_3"
            },
            "state": "lit"
          },
          {
            "type": "addFlag",
            "name": "flames",
            "amount": 1
          },
          {
            "type": "showMessage",
            "text": "The brazier flares to life."
          },
          {
            "type": "runEvent",
            "event": "checkFlames"
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "It's already burning."
          }
        ]
      },
      "plate": {
        "once": true,
        "actions": [
          {
            "type": "setConnectionState",
            "target": {
              "kind": "edge",
              "id": "crypt_hatch"
            },
            "state": "open"
          },
          {
            "type": "custom",
            "custom": "playSound",
            "params": {
              "sound": "click",
              "volume": 0.6
            }
          },
          {
            "type": "showMessage",
            "text": "Click. A trapdoor in the floor swings open."
          }
        ]
      },
      "darkness": {
        "once": true,
        "conditions": [
          {
            "type": "custom",
            "custom": "hasLight"
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "You land in the crypt. Your torch shows bones heaped against the walls."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "You land in total darkness. Something shifts nearby."
          }
        ]
      },
      "openSarcophagus": {
        "once": true,
        "actions": [
          {
            "type": "setPropState",
            "target": {
              "kind": "prop",
              "id": "sarcophagus"
            },
            "state": "open"
          },
          {
            "type": "setFlag",
            "name": "relic",
            "value": true
          },
          {
            "type": "custom",
            "custom": "spawnMonster",
            "params": {
              "monster": "skeleton",
              "at": {
                "x": 1,
                "y": 7,
                "z": -1
              }
            }
          },
          {
            "type": "showMessage",
            "text": "You lift the relic from the sarcophagus. Behind you, bones begin to rattle."
          }
        ]
      },
      "lastWords": {
        "conditions": [
          {
            "type": "flag",
            "name": "relic",
            "op": "==",
            "value": true
          }
        ],
        "actions": [
          {
            "type": "showMessage",
            "text": "You climb out with the relic. Well done."
          }
        ],
        "else": [
          {
            "type": "showMessage",
            "text": "You climb the ladder. The relic is still below."
          }
        ]
      }
    },
    "flags": {
      "flames": {
        "type": "int",
        "initial": 0
      },
      "relic": {
        "type": "bool",
        "initial": false
      }
    }
