  "events": {
    "draft": {
      "once": true,
      "actions": [
        {
          "type": "showMessage",
          "text": "A cold draft slides past you. The stone here is damp."
        }
      ]
    },
    "openChest": {
      "once": true,
      "actions": [
        {
          "type": "setPropState",
          "target": {
            "kind": "prop",
            "id": "chest"
          },
          "state": "open"
        },
        {
          "type": "setFlag",
          "name": "treasure",
          "value": true
        },
        {
          "type": "showMessage",
          "text": "The chest opens. Gold! You win the demo."
        }
      ]
    },
    "toggleGate": {
      "conditions": [
        {
          "type": "state",
          "target": {
            "kind": "edge",
            "id": "gate"
          },
          "equals": "closed"
        }
      ],
      "actions": [
        {
          "type": "setConnectionState",
          "target": {
            "kind": "edge",
            "id": "gate"
          },
          "state": "open"
        },
        {
          "type": "setPropState",
          "target": {
            "kind": "prop",
            "id": "lever1"
          },
          "state": "on"
        },
        {
          "type": "showMessage",
          "text": "Chains rattle. The gate rises."
        }
      ],
      "else": [
        {
          "type": "setConnectionState",
          "target": {
            "kind": "edge",
            "id": "gate"
          },
          "state": "closed"
        },
        {
          "type": "setPropState",
          "target": {
            "kind": "prop",
            "id": "lever1"
          },
          "state": "off"
        },
        {
          "type": "showMessage",
          "text": "The gate grinds shut again."
        }
      ]
    },
    "trap": {
      "once": true,
      "actions": [
        {
          "type": "setConnectionState",
          "target": {
            "kind": "edge",
            "id": "door"
          },
          "state": "locked"
        },
        {
          "type": "showMessage",
          "text": "The door slams shut behind you and the lock turns."
        }
      ]
    },
    "unlockDoor": {
      "conditions": [
        {
          "type": "state",
          "target": {
            "kind": "edge",
            "id": "door"
          },
          "equals": "locked"
        }
      ],
      "actions": [
        {
          "type": "setConnectionState",
          "target": {
            "kind": "edge",
            "id": "door"
          },
          "state": "closed"
        },
        {
          "type": "setPropState",
          "target": {
            "kind": "prop",
            "id": "lever2"
          },
          "state": "on"
        },
        {
          "type": "showMessage",
          "text": "Click. Somewhere behind you, a lock releases."
        }
      ],
      "else": [
        {
          "type": "showMessage",
          "text": "The lever is already pulled."
        }
      ]
    },
    "welcome": {
      "once": true,
      "actions": [
        {
          "type": "showMessage",
          "text": "You wake in a cold brick room. An iron gate blocks the east wall. Look for a lever."
        }
      ]
    }
  },
