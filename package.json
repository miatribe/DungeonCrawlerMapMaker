{
  "name": "dcmm",
  "version": "0.1.0",
  "private": true,
  "description": "DCMM — Dungeon Crawler Map Maker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schemas": "tsx scripts/gen-schemas.ts",
    "examples": "tsx scripts/gen-examples.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
